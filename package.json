{
  "name": "ColorAnalyzer",
  "displayName": "Color Analyzer",
  "description": "VS Code Extension for analyzing colors used in a project",
  "version": "1.1.2",
  "engines": {
    "vscode": "^1.60.0"
  },
  "icon": "media/logo.png",
  "categories": [
    "Other"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/kennychu0510/Color-Analyzer-VS-Code-Extension"
  },
  "activationEvents": [
    "onView:ColorAnalyzer-sidebar"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "ColorAnalyzer-panel",
        "title": "Open Color Analyzer",
        "category": "Color Analyzer"
      },
      {
        "command": "ColorAnalyzer.analyzeFolder",
        "title": "Analyze Color Usage in Folder",
        "category": "Color Analyzer"
      },
      {
        "command": "ColorAnalyzer.analyzeFile",
        "title": "Analyze Color Usage in File",
        "category": "Color Analyzer"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ColorAnalyzer-sidebar-view",
          "title": "Color Analyzer",
          "icon": "media/color-palette-menu.png"
        }
      ]
    },
    "views": {
      "ColorAnalyzer-sidebar-view": [
        {
          "type": "webview",
          "id": "ColorAnalyzer-sidebar",
          "name": "Color Analyzer",
          "icon": "media/color-palette-menu.svg",
          "contextualTitle": "ColorAnalyzer"
        }
      ]
    },
    "menus": {
      "explorer/context": [
        {
          "command": "ColorAnalyzer.analyzeFolder",
          "group": "ColorAnalyzer",
          "when": "explorerResourceIsFolder"
        }
      ]
    },
    "configuration": {
      "type": "object",
      "title": "Color Analyzer",
      "properties": {
        "ColorAnalyzer.filesToScan": {
          "type": "array",
          "description": "File extension to include",
          "default": [
            ".js",
            ".jsx",
            ".tsx",
            ".ts"
          ],
          "items": {
            "type": "string"
          }
        },
        "ColorAnalyzer.directoriesToIgnore": {
          "type": "array",
          "description": "Directories to ignore in file scanning",
          "default": [
            "node_modules",
            "dist",
            "out",
            "build"
          ],
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npx vitest run && npm run package",
    "compile": "webpack",
    "watch": "concurrently \"rollup -c -w\" \"webpack --mode development --watch\" \"npm run test-watch\"",
    "package": "webpack --mode production --devtool hidden-source-map",
    "test-compile": "tsc -p ./",
    "test-watch": "tsc -watch -p ./",
    "lint": "eslint src",
    "test": "vscode-test",
    "unit-test": "npx vitest",
    "verify": "npx vitest run && npm run test"
  },
  "dependencies": {
    "@babel/parser": "^7.26.10",
    "@babel/traverse": "^7.26.10",
    "@babel/types": "^7.26.10",
    "cheerio": "^1.0.0",
    "lodash": "^4.17.23"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-commonjs": "^28.0.3",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.1.2",
    "@tsconfig/svelte": "^5.0.4",
    "@types/lodash": "^4.17.16",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.13.10",
    "@types/sinon": "^17.0.3",
    "@types/vscode": "^1.60.0",
    "@typescript-eslint/eslint-plugin": "^8.26.1",
    "@typescript-eslint/parser": "^8.26.1",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^2.4.1",
    "concurrently": "^9.1.2",
    "eslint": "^10.15.0",
    "rollup": "^4.35.0",
    "rollup-plugin-css-only": "^4.5.5",
    "rollup-plugin-svelte": "^7.2.2",
    "sinon": "^19.0.2",
    "svelte": "^5.58.0",
    "svelte-check": "^4.1.5",
    "svelte-preprocess": "^6.0.3",
    "ts-loader": "^9.5.2",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.1",
    "vitest": "^5.1.1",
    "webpack": "^5.98.0",
    "webpack-cli": "^6.0.1"
  },
  "overrides": {
    "minimatch": "^11.0.5",
    "glob": "^14.0.6",
    "tinypool": "^3.1.0",
    "js-yaml": "^4.1.1",
    "linkify-it": "^5.0.2",
    "serialize-javascript": "^7.0.3",
    "nanoid": "^3.3.11",
    "diff": "^5.2.2",
    "picomatch": "^4.0.3"
  },
  "license": "Apache-2.0",
  "publisher": "KennyChu"
}